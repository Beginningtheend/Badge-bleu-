_extrait/
extrait-capsule/
**/extrait-capsule/
*.reg
MANIFEST-sha256.csv

# Environnement virtuel Python
.venv/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Préfixes Wine et espaces de travail temporaires
*.wineprefix/
work/
bdflab-work/
